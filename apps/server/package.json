{
  "name": "@agent-tick/server",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "corepack pnpm --filter @agent-tick/db build",
    "test": "vitest run",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@agent-tick/db": "workspace:*",
    "@self-deprecated/agent-tick-shared": "workspace:*",
    "@clerk/backend": "3.4.6",
    "@fastify/static": "9.1.3",
    "fastify": "5.8.5",
    "redis": "5.12.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.12.3",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vitest": "4.1.5"
  }
}
