{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "node": "22.19.0",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "development"
      },
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "node": "22.19.0",
      "distribution": "internal"
    },
    "production": {
      "node": "22.19.0",
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "ios": {
        "companyName": "Self-Deprecated"
      }
    }
  }
}
