{
  "expo": {
    "name": "Agent Tick",
    "slug": "agenttick",
    "version": "0.1.0",
    "description": "Phone approvals for coding agents.",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "agenttick",
    "assetBundlePatterns": [
      "**/*"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/66c26d86-bff7-4681-a7b8-bc865a5212af"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.selfdeprecated.agenttick",
      "appStoreUrl": "https://apps.apple.com/app/agent-tick",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ai.selfdeprecated.agenttick",
      "playStoreUrl": "https://play.google.com/store/apps/details?id=ai.selfdeprecated.agenttick",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Agent Tick to scan pairing QR codes.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      [
        "@clerk/expo",
        {
          "appleSignIn": true
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "66c26d86-bff7-4681-a7b8-bc865a5212af"
      }
    },
    "owner": "self-deprecated",
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "notification": {
      "icon": "./assets/notification-icon.png",
      "color": "#28c61a"
    }
  }
}
