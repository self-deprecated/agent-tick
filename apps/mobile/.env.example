# Hosted Agent Tick API used by production/dev builds before a user selects a self-hosted server.
EXPO_PUBLIC_AGENT_TICK_HOSTED_SERVER_URL=https://app.agenttick.sh

# Optional shortcut for testing a self-hosted server from the sign-in screen.
# EXPO_PUBLIC_AGENT_TICK_SELF_HOSTED_SERVER_URL=https://tick.example.com

# RevenueCat keys are configured per release channel/environment.
# EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
# EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
# EXPO_PUBLIC_REVENUECAT_TEST_STORE_API_KEY=
# EXPO_PUBLIC_REVENUECAT_USE_TEST_STORE=false
