# Hosted Agent Tick API used by production/dev builds before a user selects a self-hosted server.
EXPO_PUBLIC_AGENT_TICK_HOSTED_SERVER_URL=https://app.agenttick.sh

# Optional shortcut for testing a self-hosted server from the sign-in screen.
# EXPO_PUBLIC_AGENT_TICK_SELF_HOSTED_SERVER_URL=https://tick.example.com

# RevenueCat mobile SDK keys are public client identifiers, not bearer secrets.
# The app includes production public SDK-key defaults in source; set these only
# when targeting another RevenueCat project or release channel.
# iOS TestFlight/App Store builds use the normal iOS key. Do not use RevenueCat Test Store for TestFlight submissions.
# RevenueCat Test Store is a developer harness for local/development builds only.
# Copy build-only values to apps/mobile/.env.build.local or export them in your shell before running `pnpm build:ios`.
# EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
# EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
# EXPO_PUBLIC_REVENUECAT_TEST_STORE_API_KEY=
# EXPO_PUBLIC_REVENUECAT_USE_TEST_STORE=false
