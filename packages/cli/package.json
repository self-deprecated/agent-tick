{
  "name": "agent-tick",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "agent-tick": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/fix-shebang.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx src/index.ts"
  },
  "dependencies": {
    "@agent-tick/sdk": "workspace:*",
    "@agent-tick/shared": "workspace:*",
    "commander": "^14.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "^4.21.0",
    "typescript": "6.0.3",
    "vitest": "^4.0.14"
  }
}
