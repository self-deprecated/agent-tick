{
  "name": "@self-deprecated/agent-tick-shared",
  "version": "1.3.1",
  "description": "Shared schemas and API types for Agent Tick.",
  "private": false,
  "type": "module",
  "license": "BUSL-1.1",
  "homepage": "https://agenttick.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/self-deprecated/agent-tick.git",
    "directory": "packages/shared"
  },
  "bugs": {
    "url": "https://github.com/self-deprecated/agent-tick/issues"
  },
  "sideEffects": false,
  "react-native": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "prepack": "corepack pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "4.1.5"
  }
}
